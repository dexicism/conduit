# Copy to .env.local and fill in. Everything except the secret has a dev default.

# Public URL of the app (used for auth callbacks)
BETTER_AUTH_URL=http://localhost:3000
# Public address for incoming hooks (Telegram, webhooks, forms). Defaults to BETTER_AUTH_URL.
# On your own PC, run a free tunnel and paste its https address here:
#   cloudflared tunnel --url http://localhost:3000
# PUBLIC_URL=https://something.trycloudflare.com
# Telegram bots: "polling" (default on localhost, no tunnel needed) or "webhook".
# TELEGRAM_MODE=polling
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# MongoDB (replica set required for transactions). `npm run db` starts one locally.
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0
MONGODB_DB=conduit

# Optional social sign-in. Buttons appear only when both values are set.
# Google redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub callback URL: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI steps and the Builder. Without a provider they're hidden.
#   AI_PROVIDER=ollama     free local model (install Ollama, then: ollama pull qwen3:8b)
#   AI_PROVIDER=gemini     Google Gemini, free tier (key from aistudio.google.com); reads images too
#   AI_PROVIDER=anthropic + ANTHROPIC_API_KEY=...  Claude (paid per use, from platform.claude.com)
#   ANTHROPIC_MODEL=claude-haiku-5-5   every AI step on Haiku (cheapest); keep GEMINI_API_KEY too for voice notes
#   AI_PROVIDER=fake       rule-based test model (development/tests only)
ANTHROPIC_API_KEY=
AI_PROVIDER=
# Ollama settings (defaults shown)
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_TIMEOUT_MS=300000
# OLLAMA_CONTEXT_TOKENS=16384   (more = longer prompts fit, more memory)
# Backups (defaults: daily, last 14 kept, in .data/backups). BACKUP=0 turns them off.
# BACKUP_DIR=
# BACKUP_KEEP=14
# BACKUP_EVERY_HOURS=24
# Gemini settings
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash   (any model name from aistudio.google.com)
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite   (tried when the main one is busy or out of requests; none = off)

# Connected apps: master key for saved accounts (32 random bytes, base64). Required in
# production; development generates one in .data/encryption.key. Same value on every worker.
CONDUIT_ENCRYPTION_KEY=
# Google app (Gmail, Sheets, Calendar, Drive). Redirect URI: {BETTER_AUTH_URL}/api/credentials/oauth/callback
CONNECT_GOOGLE_CLIENT_ID=
CONNECT_GOOGLE_CLIENT_SECRET=

# Behind a reverse proxy you control? Set to 1 so the chat page's per-IP limit uses
# X-Forwarded-For. Leave it off otherwise, since anyone can fake that header.
# TRUST_PROXY=1

# Email delivery for sign-in codes. Set one. With neither, development writes to
# a local outbox you can read at /dev/outbox; production refuses to start.
RESEND_API_KEY=
SMTP_URL=
EMAIL_FROM="Conduit <no-reply@example.com>"
